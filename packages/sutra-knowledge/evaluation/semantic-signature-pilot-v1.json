    {
      "id": "P01",
      "question": "Did the current-period amount exceed the threshold?",
      "inputs": {
        "current": "12",
        "prior": "12",
        "threshold": "10"
      },
      "programs": [
        {
          "id": "prior_wrong",
          "formula": "[prior]>[threshold]",
          "semanticLabel": "WRONG",
          "copies": 3,
          "expected": [
            "constraint_satisfied",
            "constraint_satisfied",
            "constraint_refuted"
          ]
        },
        {
          "id": "current_right",
          "formula": "[current]>[threshold]",
          "semanticLabel": "RIGHT",
          "copies": 1,
          "expected": [
            "constraint_satisfied",
            "constraint_refuted",
            "constraint_satisfied"
          ]
        }
      ],
      "scenarios": [
        {
          "id": "s01",
          "replacements": {
            "current": "8/1"
          }
        },
        {
          "id": "s02",
          "replacements": {
            "prior": "8/1"
          }
        }
      ],
      "expectedWitness": true
    },
    {
