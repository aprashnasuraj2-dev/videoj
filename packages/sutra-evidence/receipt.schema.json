{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SUTRA evidence receipt v1",
  "description": "Shape contract; end > start and source/cue matching require runtime validation. No semantic truth guarantee.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceId",
    "sourceHash",
    "cueId",
    "start",
    "end",
    "excerpt",
    "retrievedAt",
    "verification",
    "sourceVersion",
    "mediaHash"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cueId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "start": {
      "type": "number",
      "minimum": 0
    },
    "end": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "excerpt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "retrievedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verification": {
      "const": "unverified"
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "mediaHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
