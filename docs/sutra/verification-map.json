{
  "schema": 1,
  "managedRoots": [
    "apps/sutra/",
    "apps/sutra-peer/",
    "packages/sutra-",
    "services/sutra-api/",
    "tools/sutra-",
    "deploy/sutra-pages/",
    "docs/sutra/evaluation/"
  ],
  "suites": [
    {
      "id": "grounding-evaluation",
      "prefixes": [
        "apps/sutra/src/comparison",
        "apps/sutra/src/uncertainty",
        "apps/sutra/src/direct-lookup",
        "apps/sutra/src/receipt-actions",
        "packages/sutra-evidence/",
        "packages/sutra-source-tools/",
        "packages/sutra-runtime/",
        "services/sutra-api/",
        "tools/sutra-evaluation/",
        "docs/sutra/evaluation/",
        "apps/sutra/public/guides/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA engineering evaluation",
        "Validate SUTRA learner shell"
      ],
      "invalidates": [
        "engineering_baseline"
      ],
      "reason": "Retrieval, claim validation, orchestration or source-handler changes can alter evidence accuracy and abstention behavior."
    },
    {
      "id": "critical-journey",
      "prefixes": [
        "apps/sutra/src/",
        "apps/sutra/public/media/",
        "packages/sutra-actions/",
        "packages/sutra-evidence/",
        "packages/sutra-source-tools/",
        "packages/sutra-runtime/",
        "packages/sutra-inference/",
        "services/sutra-api/",
        "apps/sutra/public/guides/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA learner shell"
      ],
      "invalidates": [
        "hero_journey"
      ],
      "reason": "Learner, media, action, evidence or runtime changes can alter the visible end-to-end task."
    },
    {
      "id": "browser-matrix",
      "prefixes": [
        "apps/sutra/src/",
        "apps/sutra/public/media/",
        "apps/sutra/package.json",
        "apps/sutra/package-lock.json",
        "apps/sutra/vite.config",
        "packages/sutra-runtime/",
        "packages/sutra-evidence/",
        "packages/sutra-source-tools/",
        "packages/sutra-consent/",
        "packages/sutra-inference/",
        "packages/sutra-actions/",
        "apps/sutra/public/guides/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA browser compatibility matrix"
      ],
      "invalidates": [
        "desktop_browser_matrix"
      ],
      "reason": "Client/runtime/media changes can alter behavior across Chromium, Firefox and WebKit."
    },
    {
      "id": "peer-interop",
      "prefixes": [
        "apps/sutra-peer/",
        "packages/sutra-runtime/",
        "packages/sutra-consent/",
        "tools/sutra-neutral-consumer/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA neutral consumer"
      ],
      "invalidates": [
        "neutral_peer_interop"
      ],
      "reason": "Peer publication, consent or runtime changes can alter independent caller/peer behavior."
    },
    {
      "id": "performance-profile",
      "prefixes": [
        "apps/sutra/src/",
        "apps/sutra/public/media/",
        "apps/sutra/package.json",
        "apps/sutra/package-lock.json",
        "apps/sutra/vite.config"
      ],
      "requiredWorkflows": [
        "Validate SUTRA learner shell"
      ],
      "invalidates": [
        "lab_performance"
      ],
      "reason": "Bundle, media or learner changes can alter the transcript-first laboratory profile."
    },
    {
      "id": "provider-cost",
      "prefixes": [
        "apps/sutra/src/provider-",
        "packages/sutra-inference/",
        "services/sutra-api/",
        "tools/sutra-provider-measurement/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA learner shell",
        "Validate SUTRA provider measurement gate"
      ],
      "invalidates": [
        "provider_cost"
      ],
      "reason": "Provider transport, prompt/context or quota changes can alter calls, token usage and cost."
    },
    {
      "id": "publication-integrity",
      "prefixes": [
        "apps/sutra/public/agents/",
        "apps/sutra/tools/publication-inventory",
        "apps/sutra-peer/",
        "deploy/sutra-pages/",
        "tools/sutra-starter/",
        "apps/sutra/public/guides/",
        "apps/sutra/public/_",
        "apps/sutra/tools/",
        "tools/sutra-open-kit/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA publisher starter",
        "Validate SUTRA Open Kit candidate"
      ],
      "invalidates": [
        "publication_inventory"
      ],
      "reason": "Public graph, guide, starter or deployment-candidate changes can alter portable artifact identity."
    },
    {
      "id": "security-boundary",
      "prefixes": [
        "apps/sutra/src/peer-",
        "apps/sutra/src/provider-",
        "packages/sutra-runtime/",
        "packages/sutra-consent/",
        "packages/sutra-inference/",
        "services/sutra-api/",
        "deploy/sutra-pages/",
        "apps/sutra/public/_headers",
        "apps/sutra/public/_routes"
      ],
      "requiredWorkflows": [
        "Validate SUTRA learner shell",
        "Validate SUTRA neutral consumer",
        "Validate SUTRA Cloudflare ingress"
      ],
      "invalidates": [
        "security_boundary"
      ],
      "reason": "Contact, consent, inference, API or ingress changes can affect credentials, disclosure and execution boundaries."
    },
    {
      "id": "verification-tests",
      "prefixes": [
        "apps/sutra/test/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA learner shell",
        "Validate SUTRA browser compatibility matrix"
      ],
      "invalidates": [],
      "reason": "Changes to executable product tests must run the relevant verification suites but do not by themselves rewrite measured product metrics."
    },
    {
      "id": "user-study-readiness",
      "prefixes": [
        "tools/sutra-user-study/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA user-study scoring gate"
      ],
      "invalidates": [],
      "reason": "Changes to the counterbalanced study protocol must pass its scorer/assignment tests; no human-study metric exists until real participant observations are collected."
    },
    {
      "id": "builder-trial-readiness",
      "prefixes": [
        "tools/sutra-builder-trial/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA outside-builder trial gate"
      ],
      "invalidates": [],
      "reason": "Changes to the outside-builder adoption protocol must pass its de-identified trial scorer; no adoption metric exists until real external trials occur."
    },
    {
      "id": "physical-device-readiness",
      "prefixes": [
        "tools/sutra-device-check/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA physical-device evidence gate"
      ],
      "invalidates": [],
      "reason": "Changes to the physical-device record protocol must pass its completeness/core-flow tests; no physical-device metric exists until a human attests a real device observation."
    },
    {
      "id": "content-intake-readiness",
      "prefixes": [
        "tools/sutra-content-intake/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA real-content intake gate"
      ],
      "invalidates": [],
      "reason": "Changes to real-content intake validation must pass byte/path/declaration tests; no rights or factual-review metric exists until real assets and human evidence are supplied."
    },
    {
      "id": "screenreader-readiness",
      "prefixes": [
        "tools/sutra-screenreader-check/"
      ],
      "requiredWorkflows": [
        "Validate SUTRA screen-reader evidence gate"
      ],
      "invalidates": [],
      "reason": "Changes to the human screen-reader acceptance record protocol must pass its completeness/core-interaction tests; automated checks never become human AT evidence."
    }
  ]
}
