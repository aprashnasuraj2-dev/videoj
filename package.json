{
  "name": "dhago",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:storyboard && npm run prepare:weave && vite",
    "build": "node scripts/ensure-webm.mjs && npm run prepare:storyboard && npm run prepare:weave && vite build && node scripts/size-report.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "node apps/preview/deploy.mjs",
    "deploy:vercel": "npx --yes vercel@64 build && npx --yes vercel@64 deploy --prebuilt",
    "deploy:netlify": "npx --yes netlify-cli@27 deploy --build",
    "deploy:cloudflare": "npm run build && npx --yes wrangler@4 pages deploy dist --project-name dhago",
    "test": "playwright test",
    "prepare:weave": "node scripts/compile-weave.mjs && node scripts/compile-weave.mjs apps/preview/public/media/from-fibre-to-fabric.mp4 apps/preview/public/media/from-fibre-to-fabric-chapters.vtt apps/preview/src/weave-fibre.json apps/preview/public/media/from-fibre-to-fabric.weave.svg",
    "size:report": "node scripts/size-report.mjs",
    "prepare:storyboard": "python3 scripts/generate-storyboard.py apps/preview/public/media/from-fibre-to-fabric.mp4"
  },
  "dependencies": {
    "@videojs/html": "10.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@base-ui/react": "^1.6.0",
    "@heroicons/react": "^2.2.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@videojs/mux-video": "10.4.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
